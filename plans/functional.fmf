# 功能测试计划
# 执行所有功能测试用例

summary: 功能测试 - 验证所有功能测试用例

environment-file:
  - topology.env

discover:
  how: fmf
  # 发现所有标记为 functional 的测试
  filter: "tag:functional"

provision:
  how: local

execute:
  how: tmt

prepare:
  how: shell
  script:
    - echo "准备测试环境..."
    - dnf install -y curl wget 2>/dev/null || true

report:
  how: display