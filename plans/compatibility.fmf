# 兼容性测试计划
# 验证系统在不同环境下的兼容性

summary: 兼容性测试 - 验证系统兼容性

environment-file:
  - topology.env

discover:
  how: fmf
  filter: "tag:compatibility"

provision:
  how: local

prepare:
  - how: shell
    name: requires
    script:
      - echo ""
  - how: shell
    script:
      - echo ""

execute:
  how: tmt

report:
  how: display