summary: K8s pod scheduling verification
tag:
 - feature
 - k8s
 - riscv
 - scheduling
duration: 20m
tier: 2

/test_k8s_scheduling_nodeselector:
  summary: Verify Pod nodeSelector constraint schedules Pod to the correct node
  test: ./test_k8s_scheduling_nodeselector.sh
  tag: [feature, k8s, riscv, scheduling]
  duration: 5m
  tier: 2

/test_k8s_scheduling_affinity:
  summary: Verify Pod affinity and anti-affinity rules
  test: ./test_k8s_scheduling_affinity.sh
  tag: [feature, k8s, riscv, scheduling]
  duration: 5m
  tier: 2

/test_k8s_scheduling_taints_tolerations:
  summary: Verify Pod tolerations allow scheduling onto tainted nodes
  test: ./test_k8s_scheduling_taints_tolerations.sh
  tag: [feature, k8s, riscv, scheduling]
  duration: 5m
  tier: 2

/test_k8s_scheduling_resource_quota:
  summary: Verify ResourceQuota enforcement in namespace
  test: ./test_k8s_scheduling_resource_quota.sh
  tag: [feature, k8s, riscv, scheduling]
  duration: 5m
  tier: 2
