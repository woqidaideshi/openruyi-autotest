summary: K8s smoke verification - cluster health and basic connectivity (Sonobuoy-equivalent)
tag:
 - feature
 - k8s
 - riscv
 - smoke
duration: 15m
tier: 1

/test_k8s_smoke_arch_check:
  summary: Verify all cluster nodes report riscv64 architecture
  test: ./test_k8s_smoke_arch_check.sh
  tag:
   - feature
   - k8s
   - riscv
   - smoke
  duration: 2m
  tier: 1

/test_k8s_smoke_dns_resolve:
  summary: Verify DNS resolution of kubernetes.default.svc.cluster.local from pod
  test: ./test_k8s_smoke_dns_resolve.sh
  tag:
   - feature
   - k8s
   - riscv
   - smoke
  duration: 3m
  tier: 1

/test_k8s_smoke_api_reachable:
  summary: Verify API Server /version endpoint reachable from pod via ServiceAccount token
  test: ./test_k8s_smoke_api_reachable.sh
  tag:
   - feature
   - k8s
   - riscv
   - smoke
  duration: 3m
  tier: 1

/test_k8s_smoke_daemonset:
  summary: Equivalent of Sonobuoy RISC-V smoke plugin - DaemonSet-based architecture/DNS/API check
  test: ./test_k8s_smoke_daemonset.sh
  tag:
   - feature
   - k8s
   - riscv
   - smoke
  duration: 5m
  tier: 1
