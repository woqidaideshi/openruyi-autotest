summary: 安全测试 - nmap 网络扫描工具
contact: QA Team
tag:
  - security
  - nmap
tier: 1
require:
  - nmap
duration: 15m
path: /tests/security/nmap

/test_nmap_port_scan:
  summary: nmap TCP/UDP 端口扫描
  test: ./test_nmap_port_scan.sh

/test_nmap_service_detection:
  summary: nmap 服务版本检测
  test: ./test_nmap_service_detection.sh

/test_nmap_os_fingerprinting:
  summary: nmap 操作系统指纹识别
  test: ./test_nmap_os_fingerprinting.sh

/test_nmap_nse_scripts:
  summary: nmap NSE 脚本扫描
  test: ./test_nmap_nse_scripts.sh

/test_nmap_firewall_evasion:
  summary: nmap 防火墙/IDS 规避
  test: ./test_nmap_firewall_evasion.sh

/test_nmap_host_discovery:
  summary: nmap 网络主机发现
  test: ./test_nmap_host_discovery.sh

/test_nmap_ssl_tls_analysis:
  summary: nmap SSL/TLS 安全分析
  test: ./test_nmap_ssl_tls_analysis.sh

/test_nmap_output_formats:
  summary: nmap 输出格式
  test: ./test_nmap_output_formats.sh